#!/usr/bin/env bash
# =============================================================================
#  sysinfo — painel de status exibido ao abrir o terminal
#
#  Projeto: ~/Code/terminal-dashboard
#  Uso:
#    sysinfo                  mostra o painel
#    sysinfo cpu              modelo, núcleos/threads, iGPU e temperatura da CPU
#    sysinfo gpu              GPUs, VRAM, uso, temperatura e tipo
#    sysinfo disks            detalhes dos discos e partições
#    sysinfo ram [--update]   slots, tipo, frequência e temperatura da RAM
#    sysinfo ports [--all] [-v]  portas em escuta, processo e container
#    sysinfo bench [dir]      benchmark de escrita/leitura sequencial
#    sysinfo --help           mostra a ajuda
#
#  Configuração (variáveis de ambiente):
#    SYSINFO_DISABLE=1          desativa o painel
#    SYSINFO_DELAY=0.25         janela de amostragem de CPU/rede/disco (s)
#    SYSINFO_BAR_WIDTH=14       largura das barras de CPU/MEM/SWAP (6 a 40)
#    SYSINFO_NO_COLOR=1         desativa cores (NO_COLOR também funciona)
#    SYSINFO_NET_CHECK=0        não testa conectividade com a internet
#    SYSINFO_NET_TIMEOUT=0.5    tempo máximo do teste de internet (s)
#    SYSINFO_PING_HOST=1.1.1.1  host usado no teste de internet
#    SYSINFO_BENCH_SIZE=256     tamanho do benchmark do CLI, em MiB
#    SYSINFO_DISKS_DELAY=0.3    janela de amostragem de I/O em "sysinfo disks"
#    SYSINFO_DOCKER_CHECK=0     não consulta o Docker ao listar portas
#
#    SYSINFO_PANEL=all          composição: all, compact, none ou lista de
#                               header,cpu,gpu,mem,swap,ram,disks,net,internet,
#                               ports,bench,uptime,battery,temp,services
#    SYSINFO_PANEL_HIDE=...     tokens removidos da composição
#    SYSINFO_PANEL_CPU=full     full (modelo/iGPU), summary ou off
#    SYSINFO_PANEL_GPU=full     full (detalhes), summary ou off
#    SYSINFO_PANEL_DISKS=full   full (detalhes) ou summary (uma linha por disco)
#    SYSINFO_PANEL_RAM=full     full (slots), summary ou off
#    SYSINFO_PANEL_PORTS=table  table (lista) ou summary (linha-resumo)
#    SYSINFO_PANEL_PORTS_MAX=0  máximo de portas listadas (0 = todas)
#    SYSINFO_PANEL_BENCH=auto   auto (cache expirado), live, cache ou off
#    SYSINFO_BENCH_PANEL_SIZE=32  tamanho do bench rápido do painel, em MiB
#    SYSINFO_BENCH_TTL_DAYS=7   validade do cache do bench, em dias
#    SYSINFO_PANEL_COLUMNS=auto auto, 1 ou 2 (duas colunas em terminais largos)
#    SYSINFO_PANEL_HINT=0       esconde o rodapé de dicas
#    SYSINFO_CACHE_DIR=...      diretório do cache (padrão XDG_CACHE_HOME/sysinfo)
#    SYSINFO_RAM_DMI_FILE=...   usa um dump de "dmidecode -t memory" em vez do cache
#
#  Dependências: bash, coreutils, util-linux e /proc + /sys. Opcionais: ss
#  (portas), docker (containers nas portas), iw (Wi-Fi), ping (internet),
#  systemctl (serviços) e smartctl (saúde/SMART em "sysinfo disks").
#
#  Código dividido em lib/ (uma responsabilidade por arquivo). Este entrypoint
#  resolve o próprio symlink para encontrar lib/ mesmo via ~/.local/bin.
# =============================================================================

set -uo pipefail

# "sudo sysinfo ram --update" deve usar o cache do usuário que chamou o sudo,
# não o /root. O comando também funciona sem sudo (ele chama o sudo sozinho).
if (( EUID == 0 )) && [[ -n ${SUDO_USER:-} && ${SUDO_USER} != root ]]; then
  _sudo_home=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)
  [[ -n $_sudo_home ]] && export HOME=$_sudo_home
  unset _sudo_home
fi

self=$(readlink -f -- "${BASH_SOURCE[0]}")
lib_dir=$(cd -- "$(dirname -- "$self")/../lib" && pwd)

# shellcheck source=lib/config.sh
. "$lib_dir/config.sh"

cleanup() {
  [[ -n ${probe_file:-} ]] && rm -f "$probe_file"
  [[ -n ${bench_file:-} ]] && rm -f "$bench_file"
}
trap cleanup EXIT

mode=panel

help() {
  cat <<'HELP'
sysinfo — resumo do sistema exibido ao abrir o terminal

Uso:
  sysinfo                  mostra o painel
  sysinfo cpu              modelo, marca, núcleos/threads, iGPU e temperatura
  sysinfo gpu              GPUs, VRAM, uso, temperatura e tipo
  sysinfo disks            discos, partições, uso, I/O e temperatura
  sysinfo ram              slots, tipo, frequência, fabricante e temperatura da RAM
  sysinfo ram --update     relê o DMI com sudo e atualiza o cache
  sysinfo ports            lista as portas TCP em escuta e o processo/docker
  sysinfo ports --all      lista TCP + UDP
  sysinfo ports -v         mostra diretório e linha de comando do processo
  sysinfo bench [dir]      benchmark de escrita/leitura sequencial
  sysinfo --help           mostra esta ajuda
  sysinfo --version        mostra a versão

Variáveis de ambiente:
  SYSINFO_DISABLE=1          desativa o painel
  SYSINFO_DELAY=0.25         janela de amostragem de CPU/rede/disco, em s
  SYSINFO_BAR_WIDTH=14       largura das barras de CPU/MEM/SWAP (6 a 40)
  SYSINFO_NO_COLOR=1         desativa as cores (NO_COLOR também funciona)
  SYSINFO_NET_CHECK=0        não testa conectividade com a internet
  SYSINFO_NET_TIMEOUT=0.5    tempo máximo do teste de internet, em s
  SYSINFO_PING_HOST=1.1.1.1  host usado no teste de internet
  SYSINFO_BENCH_SIZE=256     tamanho do benchmark do CLI, em MiB
  SYSINFO_DISKS_DELAY=0.3    janela de amostragem de I/O em "sysinfo disks"
  SYSINFO_DOCKER_CHECK=0     não consulta o Docker ao listar portas

Composição do painel:
  SYSINFO_PANEL=all          all, compact, none ou lista separada por vírgulas:
                             header,cpu,gpu,mem,swap,ram,disks,net,internet,
                             ports,bench,uptime,battery,temp,services
                             (aliases: memory, network/wifi, load)
  SYSINFO_PANEL_HIDE=...     remove tokens da composição
  SYSINFO_PANEL_COLUMNS=auto auto, 1 ou 2 (duas colunas em terminais largos)
  SYSINFO_PANEL_HINT=0       esconde o rodapé de dicas

Detalhes e desempenho:
  SYSINFO_PANEL_CPU=full     full (modelo/iGPU), summary ou off
  SYSINFO_PANEL_GPU=full     full (VRAM/uso/temp), summary ou off
  SYSINFO_PANEL_DISKS=full   full (detalhes/partições) ou summary
  SYSINFO_PANEL_RAM=full     full (lista os slots), summary (uma linha) ou off
  SYSINFO_PANEL_PORTS=table  table (lista) ou summary (linha-resumo)
  SYSINFO_PANEL_PORTS_MAX=0  máximo de portas listadas (0 = todas)
  SYSINFO_PANEL_BENCH=auto   auto (refaz se o cache expirou), live, cache, off
  SYSINFO_BENCH_PANEL_SIZE=32  tamanho do bench rápido do painel, em MiB
  SYSINFO_BENCH_TTL_DAYS=7   validade do cache do bench, em dias
  SYSINFO_CACHE_DIR=...      cache do bench e da RAM (padrão: XDG_CACHE_HOME/sysinfo)
  SYSINFO_RAM_DMI_FILE=...   dump de "dmidecode -t memory" para os detalhes de RAM

Exemplos:
  SYSINFO_PANEL=compact sysinfo
  SYSINFO_PANEL_HIDE=bench,services sysinfo
  SYSINFO_PANEL=header,cpu,mem,disks sysinfo
  SYSINFO_PANEL_BENCH=off sysinfo
HELP
}

case ${1:-} in
  -h|--help) help; exit 0 ;;
  -V|--version) printf 'sysinfo %s\n' "$version"; exit 0 ;;
  ports|--ports) mode=ports ;;
  disks|--disks) mode=disks ;;
  cpu|processor|--cpu) mode=cpu ;;
  gpu|video|vga|--gpu) mode=gpu ;;
  ram|mem|memory|--ram) mode=ram ;;
  bench|--bench) mode=bench; bench_target=${2:-$HOME} ;;
  '') ;;
  *) printf 'sysinfo: opção desconhecida: %s\n' "$1" >&2; exit 2 ;;
esac

if [[ $mode == panel ]]; then
  [[ -t 1 ]] || exit 0
  if [[ -n ${SYSINFO_DISABLE:-} && ${SYSINFO_DISABLE} != 0 ]]; then
    exit 0
  fi
fi

# shellcheck source=lib/ui.sh
. "$lib_dir/ui.sh"
# shellcheck source=lib/system.sh
. "$lib_dir/system.sh"
# shellcheck source=lib/disks.sh
. "$lib_dir/disks.sh"
# shellcheck source=lib/network.sh
. "$lib_dir/network.sh"
# shellcheck source=lib/ports.sh
. "$lib_dir/ports.sh"
# shellcheck source=lib/bench.sh
. "$lib_dir/bench.sh"
# shellcheck source=lib/memory.sh
. "$lib_dir/memory.sh"
# shellcheck source=lib/cpu.sh
. "$lib_dir/cpu.sh"
# shellcheck source=lib/gpu.sh
. "$lib_dir/gpu.sh"
# shellcheck source=lib/panel.sh
. "$lib_dir/panel.sh"

case $mode in
  ports) shift; show_ports "$@" ;;
  disks) show_disks ;;
  cpu) shift; show_cpu "$@" ;;
  gpu) shift; show_gpu "$@" ;;
  ram) shift; show_ram "$@" ;;
  bench) show_bench "$bench_target" ;;
  panel) render_panel ;;
esac
